{
  "name": "ordering/order",
  "type": "project",
  "license": "proprietary",
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.4",
    "ext-json": "*",
    "ext-openssl": "*",
    "api-platform/core": "^4.0",
    "doctrine/doctrine-bundle": "^3.2",
    "doctrine/orm": "^3.3",
    "lexik/jwt-authentication-bundle": "^3.0",
    "sentry/sentry-symfony": "^5.7",
    "symfony/asset": "^8.0",
    "symfony/cache": "^8.0",
    "symfony/console": "^8.0",
    "symfony/dotenv": "^8.0",
    "symfony/form": "^8.0",
    "symfony/framework-bundle": "^8.0",
    "symfony/intl": "^8.0",
    "symfony/messenger": "^8.0",
    "symfony/monolog-bundle": "^3.0",
    "symfony/rate-limiter": "^8.0",
    "symfony/runtime": "^8.0",
    "symfony/security-bundle": "^8.0",
    "symfony/serializer": "^8.0",
    "symfony/twig-bundle": "^8.0",
    "symfony/uid": "^8.0",
    "symfony/validator": "^8.0",
    "symfony/workflow": "^8.0",
    "symfony/yaml": "^8.0",
      "ext-bcmath": "*",
      "ext-curl": "*",
      "ext-zlib": "*",
      "ext-redis": "*",
      "ext-sodium": "*"
  },
  "require-dev": {
    "doctrine/doctrine-fixtures-bundle": "^4.3",
    "doctrine/doctrine-migrations-bundle": "^4.0",
    "fakerphp/faker": "^1.24",
    "friendsofphp/php-cs-fixer": "^3.94",
    "phpmd/phpmd": "^2.15",
    "phpstan/phpstan": "^1.12",
    "phpunit/phpunit": "^10.5",
    "symfony/browser-kit": "^8.0",
    "symfony/css-selector": "^8.0",
    "symfony/panther": "^2.4"
  },
  "scripts": {
    "test": "phpunit --configuration phpunit.xml.dist --testsuite OrderFast",
    "test:full": "phpunit --configuration phpunit.xml.dist --testsuite OrderFullStack",
    "test:panther": "php vendor/bin/phpunit --configuration phpunit.xml.dist tests/Panther",
    "lint:container": "php bin/console lint:container",
    "lint:yaml": "php bin/console lint:yaml config",
    "lint:twig": "php bin/console lint:twig templates",
    "db:schema:validate": "php bin/console doctrine:schema:validate -vvv",
    "owner:canon:scan": "php bin/owner-canon-scan.php",
    "owner:canon:report": "php bin/owner-canon-scan.php --write=.meta/owner-canon-scan.json",
    "owner:canon:enforce": "php bin/owner-canon-scan.php --fail-on-violations",
    "lint:php": "find src config tests -name \"*.php\" -print0 | xargs -0 -n1 php -l",
    "lint:canon": "@owner:canon:enforce",
    "fix:cs": "php vendor/bin/php-cs-fixer fix",
    "check:cs": "php vendor/bin/php-cs-fixer fix --dry-run --diff",
    "analyse": "php vendor/bin/phpstan analyse",
    "mess:detect": "php vendor/bin/phpmd src,tests text phpmd.xml",
    "pipeline:local:full": "php bin/qa-local.php"
  },
  "config": {
    "allow-plugins": {
      "symfony/runtime": true
    },
    "sort-packages": true
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
