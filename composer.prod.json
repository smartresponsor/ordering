{
    "name": "ordering/order",
    "description": "Symfony ordering component for order lifecycle, pricing, fulfillment, refunds, and operational processing.",
    "type": "project",
    "license": "proprietary",
    "autoload": {
        "psr-4": {
            "App\\Ordering\\": "src/"
        }
    },
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-curl": "*",
        "ext-json": "*",
        "ext-openssl": "*",
        "ext-sodium": "*",
        "ext-zlib": "*",
        "administering/administration": "dev-master",
        "api-platform/core": "^4.0",
        "collectioning/collection": "dev-collection-query-hardening as dev-master",
        "cruding/crud": "dev-master",
        "doctrine/collections": "^2.5",
        "doctrine/doctrine-bundle": "^3.2",
        "doctrine/orm": "^3.3",
        "easycorp/easyadmin-bundle": "^5.0",
        "interfacing/interface": "dev-master",
        "objecting/object": "dev-master",
        "psr/simple-cache": "^3.0",
        "sentry/sentry-symfony": "^5.7",
        "symfony/asset": "^8.1",
        "symfony/cache": "^8.1",
        "symfony/console": "^8.1",
        "symfony/dotenv": "^8.1",
        "symfony/form": "^8.1",
        "symfony/framework-bundle": "^8.1",
        "symfony/intl": "^8.1",
        "symfony/messenger": "^8.1",
        "symfony/monolog-bundle": "^4.0",
        "symfony/rate-limiter": "^8.1",
        "symfony/runtime": "^8.1",
        "symfony/security-bundle": "^8.1",
        "symfony/serializer": "^8.1",
        "symfony/twig-bundle": "^8.1",
        "symfony/uid": "^8.1",
        "symfony/validator": "^8.1",
        "symfony/workflow": "^8.1",
        "symfony/yaml": "^8.1",
        "tabling/table": "dev-backend-table-actions as dev-master",
        "viewing/view": "dev-master"
    },
    "config": {
        "allow-plugins": {
            "symfony/runtime": true
        },
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "repositories": [
        {
            "type": "vcs",
            "url": "git@github.com:smartresponsor/administering.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "git@github.com:smartresponsor/collectioning.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "git@github.com:smartresponsor/cruding.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "git@github.com:smartresponsor/interfacing.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "git@github.com:smartresponsor/objecting.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "git@github.com:smartresponsor/tabling-.git",
            "no-api": true
        },
        {
            "type": "vcs",
            "url": "git@github.com:smartresponsor/viewing.git",
            "no-api": true
        }
    ]
}
