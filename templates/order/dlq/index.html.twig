{% extends '@Twig/Exception/error.html.twig' ignore missing %}
{% block title %}Order DLQ{% endblock %}
{% block body %}
<style>
  body{font-family:system-ui,Segoe UI,Roboto,Arial,sans-serif;margin:24px}
  table{border-collapse:collapse;width:100%}
  th,td{border:1px solid #ddd;padding:8px;font-size:14px}
  th{background:#f3f3f3;text-align:left}
  .meta{margin:8px 0 16px;color:#666}
  .pager a{margin-right:8px}
  code{background:#f6f6f6;padding:2px 4px;border-radius:3px}
</style>
<h2>Order DLQ</h2>
<div class="meta">
  total: <b>{{ total }}</b> &middot; limit: {{ limit }} &middot; offset: {{ offset }}
</div>

<table>
  <thead><tr>
    <th>#</th><th>id</th><th>topic</th><th>attempt</th><th>status</th><th>occurredAt</th><th>reason</th>
  </tr></thead>
  <tbody>
  {% for m in items %}
    <tr>
      <td>{{ loop.index0 }}</td>
      <td>{{ m.id ?? (m.getId ? m.getId : '') }}</td>
      <td>{{ m.topic ?? (m.getTopic ? m.getTopic : '') }}</td>
      <td>{{ m.attempt ?? (m.getAttempt ? m.getAttempt : '') }}</td>
      <td>{{ m.status ?? (m.getStatus ? m.getStatus : '') }}</td>
      <td>{% set dt = m.occurredAt ?? (m.getOccurredAt ? m.getOccurredAt : null) %}{{ dt ? dt|date('c') : '' }}</td>
      <td>{{ m.reason ?? (m.getHeader ? m.getHeader : '') }}</td>
    </tr>
  {% else %}
    <tr><td colspan="7">No items</td></tr>
  {% endfor %}
  </tbody>
</table>

<div class="pager" style="margin-top:12px">
  {% set base = path('order_dlq_ui', {'topic': topic, 'q': q, 'limit': limit}) %}
  {% set prev = offset - limit %}
  {% set next = offset + limit %}
  {% if prev >= 0 %}<a href="{{ base ~ '&offset=' ~ prev }}">← Prev</a>{% endif %}
  {% if next < total %}<a href="{{ base ~ '&offset=' ~ next }}">Next →</a>{% endif %}
</div>

<p style="margin-top:16px">
  Requeue via API or CLI:<br>
  <code>curl -X POST /order/dlq/{id}/requeue</code> or <code>bin/console order:dlq:requeue ID1 ID2</code>
</p>
{% endblock %}
