{% extends '@Interfacing/base.html.twig' %}

{% block title %}Order Management{% endblock %}

{% block body %}
    <div class="row g-4">
        <div class="col-12 col-xl-4">
            <div class="card shadow-sm">
                <div class="card-header">
                    <h1 class="h5 mb-0">Create demo order</h1>
                </div>
                <div class="card-body">
                    {{ form_start(create_form) }}
                    <div class="mb-3">{{ form_row(create_form.currency) }}</div>
                    <div class="mb-3">{{ form_row(create_form.grandTotal) }}</div>
                    {{ form_row(create_form.submit, { attr: { class: 'btn btn-primary' } }) }}
                    {{ form_end(create_form) }}
                </div>
            </div>
        </div>

        <div class="col-12 col-xl-8">
            <div class="card shadow-sm">
                <div class="card-header d-flex justify-content-between align-items-center">
                    <h2 class="h5 mb-0">Orders</h2>
                    <span class="badge text-bg-secondary">{{ orders|length }} records</span>
                </div>
                <div class="card-body">
                    {% if orders is empty %}
                        <p class="text-muted mb-0">Load fixtures or create an order to start the demo flow.</p>
                    {% else %}
                        <div class="vstack gap-3">
                            {% for order in orders %}
                                <div class="border rounded p-3 bg-white">
                                    <div class="d-flex flex-column flex-lg-row justify-content-between gap-3">
                                        <div>
                                            <div class="fw-semibold">{{ order.id }}</div>
                                            <div class="text-muted small">
                                                Status: {{ order.status|upper }}
                                                | Currency: {{ order.currency }}
                                                | Created: {{ order.createdAt|date('Y-m-d H:i') }}
                                            </div>
                                            <div class="small mt-2">
                                                Grand: {{ order.grandTotal }}
                                                | Paid: {{ order.paidTotal }}
                                                | Refunded: {{ order.refundedTotal }}
                                            </div>
                                        </div>
                                        <div class="row g-2 flex-grow-1">
                                            <div class="col-12 col-md-4">
                                                {{ form_start(payment_forms[order.id]) }}
                                                {{ form_row(payment_forms[order.id].amount) }}
                                                {{ form_row(payment_forms[order.id].externalRef) }}
                                                {{ form_row(payment_forms[order.id].submit, { attr: { class: 'btn btn-outline-success w-100' } }) }}
                                                {{ form_end(payment_forms[order.id]) }}
                                            </div>
                                            <div class="col-12 col-md-4">
                                                {{ form_start(shipment_forms[order.id]) }}
                                                {{ form_row(shipment_forms[order.id].carrier) }}
                                                {{ form_row(shipment_forms[order.id].note) }}
                                                {{ form_row(shipment_forms[order.id].submit, { attr: { class: 'btn btn-outline-primary w-100' } }) }}
                                                {{ form_end(shipment_forms[order.id]) }}
                                            </div>
                                            <div class="col-12 col-md-4">
                                                {{ form_start(refund_forms[order.id]) }}
                                                {{ form_row(refund_forms[order.id].amount) }}
                                                {{ form_row(refund_forms[order.id].reason) }}
                                                {{ form_row(refund_forms[order.id].submit, { attr: { class: 'btn btn-outline-danger w-100' } }) }}
                                                {{ form_end(refund_forms[order.id]) }}
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}
