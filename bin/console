#!/usr/bin/env php
<?php

declare(strict_types=1);

use App\Kernel;

if (!is_file(dirname(__DIR__) . '/vendor/autoload_runtime.php')) {
    throw new RuntimeException('Missing vendor/autoload_runtime.php. Run composer install.');
}

require_once dirname(__DIR__) . '/vendor/autoload_runtime.php';

return static function (array $context): Symfony\Bundle\FrameworkBundle\Console\Application {
    $kernel = new Kernel($context['APP_ENV'], (bool)$context['APP_DEBUG']);

    return new Symfony\Bundle\FrameworkBundle\Console\Application($kernel);
};
