{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "required": [
        "id",
        "status",
        "totalAmount",
        "currency"
    ],
    "properties": {
        "id": {
            "type": "string"
        },
        "status": {
            "type": "string"
        },
        "totalAmount": {
            "type": "integer",
            "minimum": 0
        },
        "currency": {
            "type": "string"
        },
        "customerId": {
            "type": "string"
        }
    }
}
